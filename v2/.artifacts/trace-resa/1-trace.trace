splay: flex;\n    flex-direction: column;\n    gap: 0.25rem;\n    padding: var(--espace-carte);\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    overflow: hidden;\n  }\n  .ui-kpi::before {\n    content: \"\";\n    position: absolute;\n    inset: 0 0 auto;\n    height: 2px;\n    background: linear-gradient(90deg, var(--accent), transparent);\n    opacity: 0.7;\n  }\n  .ui-kpi-valeur {\n    font-family: var(--police-titre);\n    font-size: 1.9rem;\n    font-weight: var(--graisse-titre);\n    letter-spacing: var(--interlettrage-titre);\n    font-variant-numeric: tabular-nums;\n  }\n  .ui-tableau {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.875rem;\n  }\n  .ui-tableau th {\n    text-align: left;\n    padding: 0.75rem 1rem;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    color: var(--encre-faine);\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n  }\n  .ui-tableau td {\n    padding: 0.75rem 1rem;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    vertical-align: top;\n  }\n  .ui-tableau tr:last-child td {\n    border-bottom: 0;\n  }\n  .ui-tableau tbody tr {\n    transition: background-color 140ms ease;\n  }\n  .ui-tableau tbody tr:hover {\n    background: var(--surface-2);\n  }\n  @supports (color: color-mix(in oklab, red, red)) {\n    .ui-tableau tbody tr:hover {\n      background: color-mix(in oklab, var(--accent) 5%, transparent);\n    }\n  }\n  .ui-menu {\n    position: relative;\n  }\n  .ui-menu > summary {\n    list-style: none;\n    cursor: pointer;\n  }\n  .ui-menu > summary::-webkit-details-marker {\n    display: none;\n  }\n  .ui-menu > summary::after {\n    content: \"＋\";\n    font-size: 0.9em;\n    line-height: 1;\n  }\n  .ui-menu[open] > summary::after {\n    content: \"−\";\n  }\n  .ui-menu-panneau {\n    position: absolute;\n    r