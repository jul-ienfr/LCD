{
  "name": "lcd-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node build",
