e-douce: #3f4756;\n  --encre-faine: #69707f;\n  --accent: #0e7c6b;\n  --accent-fonce: #0a5f52;\n  --accent-douce: #ddf2ec;\n  --sur-accent: #ffffff;\n  --ok: #15803d;\n  --ok-douce: #dcf2e4;\n  --alerte: #b45309;\n  --alerte-douce: #fdefd8;\n  --danger: #b91c1c;\n  --danger-douce: #fbe3e3;\n  --police-texte: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto,\n    \"Helvetica Neue\", Arial, sans-serif;\n  --police-titre: var(--police-texte);\n  --police-mono: ui-monospace, \"Cascadia Mono\", \"SFMono-Regular\", Consolas,\n    \"Liberation Mono\", monospace;\n  --graisse-titre: 650;\n  --interlettrage-titre: -0.02em;\n  --rayon-controle: 0.75rem;\n  --rayon-carte: 1rem;\n  --rayon-grand: 1.5rem;\n  --rayon-bouton: 999px;\n  --bordure-largeur: 1px;\n  --ombre-carte: 0 1px 2px rgb(16 24 40 / 0.06), 0 4px 16px rgb(16 24 40 / 0.08);\n  --ombre-elevee: 0 8px 30px rgb(16 24 40 / 0.16);\n  --espace-section: 2rem;\n  --espace-carte: 1.5rem;\n  --hauteur-controle: 2.75rem;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --fond: #0b0e14;\n    --surface: #131826;\n    --surface-2: #1a2132;\n    --bordure: #263049;\n    --encre: #eef1f7;\n    --encre-douce: #c2cad8;\n    --encre-faine: #8a94a8;\n    --accent: #2dd4a8;\n    --accent-fonce: #5ee8c0;\n    --accent-douce: #0e2b25;\n    --sur-accent: #0b0e14;\n    --ok: #4ade80;\n    --ok-douce: #0f2c1c;\n    --alerte: #fbbf24;\n    --alerte-douce: #2e230c;\n    --danger: #f87171;\n    --danger-douce: #2e1414;\n    --ombre-carte: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 28px rgb(0 0 0 / 0.45);\n    --ombre-elevee: 0 16px 48px rgb(0 0 0 / 0.55);\n  }\n}\nhtml.theme-clair {\n  color-scheme: light;\n}\nhtml.theme-sombre {\n  color-scheme: dark;\n}\nhtml {\n  scroll-behavior: smooth;\n}\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n  .ui-bouton, .ui-carte, .ui-tableau tbody tr {\n    transition: none;\n  }\n  .ui-bouton:hover, .ui-carte--liee:hover {\n    transform: none;\n  }\n}\nbody {\n  background: var(--fond);\n  background-attachment: fixed;\n  color: var(--encre);\n  font-family: var(--police-texte);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n@supports (color: color-mix(in oklab, red, red)) {\n  body {\n    background-image: radial-gradient( 70rem 42rem at 88% -12%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70% ), radial-gradient( 54rem 34rem at -10% 8%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 72% );\n  }\n}\n@media (max-width: 767px) {\n  body {\n    background-attachment: scroll;\n  }\n}\n.apparence {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.min-h-dvh {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.apercu-bandeau {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  padding: 0.5rem 1rem;\n  background: var(--accent);\n  color: var(--sur-accent);\n  font-size: 0.875rem;\n  font-weight: 600;\n}\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--police-titre);\n  font-weight: var(--graisse-titre);\n  letter-spacing: var(--interlettrage-titre);\n  text-wrap: balance;\n}\np {\n  text-wrap: pretty;\n}\n::selection {\n  background: var(--accent);\n  color: var(--sur-accent);\n}\ncode, pre, kbd, samp {\n  font-family: var(--police-mono);\n}\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n  border-radius: 0.5rem;\n}\n@layer components {\n  .ui-carte {\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    padding: var(--espace-carte);\n    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n  }\n  .ui-carte--liee:hover {\n    border-color: var(--accent);\n    @supports (color: color-mix(in lab, red, red)) {\n      border-color: color-mix(in oklab, var(--accent) 45%, v