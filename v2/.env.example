# Copier vers .env.local (jamais commité).
# Les valeurs ci-dessous sont des défauts de DÉVELOPPEMENT uniquement.

APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL local (docker compose -f compose.dev.yml up -d)
# Développement : le owner suffit. En production, DATABASE_URL pointe vers le
# rôle applicatif non-propriétaire et MIGRATION_DATABASE_URL vers le owner.
DATABASE_URL=postgres://lcd:lcd@127.0.0.1:5432/lcd
# MIGRATION_DATABASE_URL=postgres://lcd:lcd@127.0.0.1:5432/lcd
# APP_ROLE_NAME=lcd_app
# APP_ROLE_PASSWORD=

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev-only-change-me-please-32chars-min
BETTER_AUTH_URL=http://localhost:3000
# URLs supplémentaires autorisées (previews Netlify), séparées par des virgules.
BETTER_AUTH_TRUSTED_ORIGINS=

# Seed admin (développement uniquement — changer avant tout déploiement)
SEED_ADMIN_EMAIL=admin@lcd.test
SEED_ADMIN_PASSWORD=ChangeMe-2026!
SEED_PRESTA_EMAIL=presta@lcd.test
SEED_PRESTA_PASSWORD=ChangeMe-2026!
SEED_PROPRIO_EMAIL=proprio@lcd.test
SEED_PROPRIO_PASSWORD=ChangeMe-2026!
SEED_COMMERCIAL_EMAIL=commercial@lcd.test
SEED_COMMERCIAL_PASSWORD=ChangeMe-2026!
SEED_TENANT_SLUG=lcd

# Stockage S3-compatible (MinIO local)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=lcd
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Email (Mailpit local ou Brevo en beta)
EMAIL_ENABLED=true
EMAIL_FROM=LCD <no-reply@lcd.test>
SMTP_URL=smtp://127.0.0.1:1025

# Paiement (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assistant LLM (facultatif) : endpoint OpenAI-compatible complet.
# Sans URL/clé, l’assistant utilise le générateur local déterministe.
# Ex. https://api.openai.com/v1/chat/completions ou http://127.0.0.1:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Modèle utilisé pour l’intention « avis » avec ton chaleureux.
LLM_MODEL_PREMIUM=

# Cron OTA (facultatif)
CRON_SECRET=

# Connecteurs runtime box (facultatif) : JSON indexé par boxId.
# Ex. {"log1":{"type":"home_assistant","baseUrl":"https://ha.local","token":"..."}}
BOX_RUNTIME_CONFIG=

# Observabilité (facultatif)
SENTRY_DSN=
