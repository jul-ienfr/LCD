ackground-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;\n  }\n  .ui-bouton:hover {\n    transform: translateY(-1px);\n  }\n  .ui-bouton:disabled, .ui-bouton[aria-disabled=\"true\"] {\n    opacity: 0.55;\n    cursor: not-allowed;\n    transform: none;\n  }\n  .ui-bouton--primaire {\n    background: var(--accent);\n    color: var(--sur-accent);\n    border-color: var(--accent);\n  }\n  .ui-bouton--primaire:hover {\n    background: var(--accent-fonce);\n    border-color: var(--accent-fonce);\n  }\n  .ui-bouton--encre {\n    background: var(--encre);\n    color: var(--fond);\n    border-color: var(--encre);\n  }\n  .ui-bouton--secondaire {\n    background: var(--surface);\n    color: var(--encre);\n    border-color: var(--bordure);\n  }\n  .ui-bouton--secondaire:hover {\n    background: var(--surface-2);\n  }\n  .ui-bouton--fantome {\n    background: transparent;\n    color: var(--encre);\n    border-color: transparent;\n  }\n  .ui-bouton--fantome:hover {\n    background: var(--surface-2);\n  }\n  .ui-bouton--danger {\n    background: var(--danger);\n    color: #ffffff;\n    border-color: var(--danger);\n  }\n  .ui-bouton--petit {\n    min-height: 2.25rem;\n    padding: 0.35rem 0.8rem;\n    font-size: 0.8125rem;\n  }\n  .ui-bouton--large {\n    width: 100%;\n  }\n  .ui-champ {\n    width: 100%;\n    min-height: var(--hauteur-controle);\n    padding: 0.5rem 0.75rem;\n    background: var(--fond);\n    color: var(--encre);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    font-family: var(--police-texte);\n    font-size: 0.875rem;\n  }\n  .ui-champ:focus-visible {\n    border-color: var(--accent);\n  }\n  .ui-champ[aria-invalid=\"true\"] {\n    border-color: var(--danger);\n  }\n  .ui-label {\n    display: block;\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: var(--encre);\n  }\n  .ui-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.35rem;\n   