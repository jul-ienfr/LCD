# deploy/Caddyfile - entree unique auto-hebergee LCD (self-hosted local, 0 EUR).
#
# TOPOLOGIE F3 (IdP partout, AUCUNE entree sans IdP) :
#   lcd.test:4001 (HTTPS) = app staff/portail - forward_auth OBLIGATOIRE
#       /api/*  -> gateway :8443 (strip prefix)
#       *       -> front web :3100 (Next SSR)
#   lcd.test:4002 (HTTPS) = PORTAIL Authelia (login + TOTP) - c'est l'IdP
#   lcd.test:4003 (HTTP)  -> redirect HTTPS :4001
# Meme hote, DEUX ports : un cookie Domain=lcd.test est indifferent au port,
# la session circule donc entre le portail et l'app - c'est ce qui rend le
# chainage possible (eprouve : Authelia repond
#   Location: https://lcd.test:4002/?rd=https%3A%2F%2Flcd.test%3A4001%2F...).
#
# forward_auth : endpoint REEL 4.39.28 = /api/authz/forward-auth (le legacy
# /api/verify repond 401 - teste sur le binaire). Sans session : 302 vers le
# portail ; politique deny : 403 ; avec TOTP : 200 + Remote-User/Groups.
# L'IDP NE PROUVE qu'une IDENTITE - le front lit Remote-User (qui reel), la
# gateway REFait son RBAC a chaque ecriture (jamais de confiance a l'en-tete).
#
# TLS `tls internal` (CA interne, zéro ACME - meme pattern lab/vps-sim).
# NOM D'ENTREE PARAMETRABLE (doctrine docs/71 - R3) : tous les sites
# utilisent `{$LCD_HOTE:lcd.test}` (nom) et `{$LCD_PORT_HTTPS:4001}` (port
# public HTTPS), fournis par l'environnement du conteneur (compose). Le meme
# fichier sert donc en local (`lcd.test`), en LAN (`LCD_HOTE=lcd.local`) et
# sur Internet (`LCD_HOTE=sas.exemple.fr`) SANS changement de code : un seul
# nom canonique par deploiement, donc un seul domaine de cookie de session.
# Ports hote : 4003 (HTTP->HTTPS) + 4001 (app) + 4002 (portail). Le socle
# (:8090-8100, :8123, :4000 box, :8050, :8060, :8443, :3100) n'est JAMAIS
# publie - le front n'est JOIGNABLE qu'ici : toute entree = IdP.
{
	email admin@example.local
	# Pas d'ACME en local : CA interne, zero appel reseau sortant.
}

(entetes_lcd) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# CSP : rien d'externe. L'app est un Next SSR avec styles/scripts
		# inline (pas de nonce : le shell serait casse), d'ou 'unsafe-inline'
		# sur style-src/script-src — assume et documente, pas oublie.
		# object-src/frame-ancestors/base-uri verrouilles, aucune eval.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}
	header Cache-Control "no-store"
}

# Limite de corps : les seuls envois legitimes sont des formulaires et des
# photos de menage. Au-dela, c'est une tentative d'epuisement memoire/disque.
(limites_lcd) {
	request_body {
		max_size 12MB
	}
}

# --- Portail IdP (login, TOTP, logout) : le SEUL acces sans session --------
https://{$LCD_HOTE:lcd.test}:4002 {
	tls internal {
		protocols tls1.2 tls1.3
	}
	import entetes_lcd
	import limites_lcd

	reverse_proxy authelia:9091 {
		header_up X-Forwarded-Proto https
		header_up -Authorization
	}
}

# --- App : TOUT passe par forward_auth (aucune exception au niveau Caddy) ---
# Les bypass (voyageur/public/health) sont declares UNE SEULE FOI dans
# Authelia access_control - une source de verite, auditables, jamais un
# handle Caddy oublie. Les bypass AUTHENTIFIENT quand meme : 200 sans
# Remote-User -> front anonyme (voyageur) ou public (health).
https://{$LCD_HOTE:lcd.test} {
	tls internal {
		protocols tls1.2 tls1.3
	}
	import entetes_lcd
	import limites_lcd

	route {
		# 1. Defense anti-spoof : un Remote-* fourni par le client est
		#    SUPPRIME avant tout traitement. Seul Authelia (copy_headers
		#    apres forward_auth reussi) a le droit d'injecter l'identite.
		#    (Forme reelle : inline, UN champ par directive — la forme bloc
		#    est rejetee "wrong argument count", teste sur caddy:2-alpine.)
		request_header -Remote-User
		request_header -Remote-Groups
		request_header -Remote-Name
		request_header -Remote-Email

		# 2. IdP : sans session valide -> 302 portail / 403 deny. Reussi ->
		#    copie Remote-User/Groups/Name dans la requete amont.
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name
		}

		# 3. Pref optin legere (lcd_lite) : service FRONT, doit preceder le
		#    catch-all /api/* -> gateway.
		handle /api/lite* {
			reverse_proxy http://web:3100 {
				header_up X-Forwarded-Proto https
				header_up -Authorization
			}
		}

		# 4. Gateway parc via /api/* (strip -> routes nues ; /api/health =
		#    bypass Authelia, le reste exige la session).
		handle /api/* {
			uri strip_prefix /api
			reverse_proxy http://gateway-parc:8443 {
				header_up X-Forwarded-Proto https
				header_up -Authorization
			}
		}

		# 5. Front Next (SSR + Server Actions) - route catch-all.
		reverse_proxy http://web:3100 {
			header_up X-Forwarded-Proto https
			header_up -Authorization
		}
	}
}

# --- HTTP : redirection HTTPS. Nom + port parametrables -------------------
# En LAN/Internet (procedure-p1) : LCD_HOTE=sas.exemple.fr + LCD_PORT_HTTPS=443,
# aucun changement Caddy. Le nom est repris de l'environnement pour que le
# redirect ne renvoie JAMAIS vers un autre hote que celui appele.
http://{$LCD_HOTE:lcd.test} {
	redir https://{$LCD_HOTE:lcd.test}:{$LCD_PORT_HTTPS:4001}{uri} permanent
}
