   }\n    .print\\:max-w-none {\n      max-width: none;\n    }\n    .print\\:rounded-none {\n      border-radius: 0;\n    }\n    .print\\:border-0 {\n      border-style: var(--tw-border-style);\n      border-width: 0px;\n    }\n    .print\\:p-0 {\n      padding: 0px;\n    }\n    .print\\:px-0 {\n      padding-inline: 0px;\n    }\n    .print\\:py-0 {\n      padding-block: 0px;\n    }\n    .print\\:shadow-none {\n      --tw-shadow: 0 0 #0000;\n      box-shadow: var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow);\n    }\n  }\n  .\\[\\&\\:\\:-webkit-details-marker\\]\\:hidden::-webkit-details-marker {\n    display: none;\n  }\n}\n:root {\n  color-scheme: light dark;\n  --fond: #f4f5f7;\n  --surface: #ffffff;\n  --surface-2: #eef0f4;\n  --bordure: #e2e5ec;\n  --encre: #131722;\n  --encre-douce: #3f4756;\n  --encre-faine: #69707f;\n  --accent: #0e7c6b;\n  --accent-fonce: #0a5f52;\n  --accent-douce: #ddf2ec;\n  --sur-accent: #ffffff;\n  --ok: #15803d;\n  --ok-douce: #dcf2e4;\n  --alerte: #b45309;\n  --alerte-douce: #fdefd8;\n  --danger: #b91c1c;\n  --danger-douce: #fbe3e3;\n  --police-texte: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto,\n    \"Helvetica Neue\", Arial, sans-serif;\n  --police-titre: var(--police-texte);\n  --police-mono: ui-monospace, \"Cascadia Mono\", \"SFMono-Regular\", Consolas,\n    \"Liberation Mono\", monospace;\n  --graisse-titre: 650;\n  --interlettrage-titre: -0.02em;\n  --rayon-controle: 0.75rem;\n  --rayon-carte: 1rem;\n  --rayon-grand: 1.5rem;\n  --rayon-bouton: 999px;\n  --bordure-largeur: 1px;\n  --ombre-carte: 0 1px 2px rgb(16 24 40 / 0.06), 0 4px 16px rgb(16 24 40 / 0.08);\n  --ombre-elevee: 0 8px 30px rgb(16 24 40 / 0.16);\n  --espace-section: 2rem;\n  --espace-carte: 1.5rem;\n  --hauteur-controle: 2.75rem;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --fond: #0b0e14;\n    --surface: #131826;\n    --surface-2: #1a2132;\n    --bordure: #263049;\n    --encre: #eef1f7;\n    --encre-douce: #c2cad8;\n    --encre-faine: #8a94a8;\n    --accent: #2dd4a8;\n    --accent-fonce: #5ee8c0;\n    --accent-douce: #0e2b25;\n    --sur-accent: #0b0e14;\n    --ok: #4ade80;\n    --ok-douce: #0f2c1c;\n    --alerte: #fbbf24;\n    --alerte-douce: #2e230c;\n    --danger: #f87171;\n    --danger-douce: #2e1414;\n    --ombre-carte: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 28px rgb(0 0 0 / 0.45);\n    --ombre-elevee: 0 16px 48px rgb(0 0 0 / 0.55);\n  }\n}\nhtml.theme-clair {\n  color-scheme: light;\n}\nhtml.theme-sombre {\n  color-scheme: dark;\n}\nhtml {\n  scroll-behavior: smooth;\n}\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n  .ui-bouton, .ui-carte, .ui-tableau tbody tr {\n    transition: none;\n  }\n  .ui-bouton:hover, .ui-carte--liee:hover {\n    transform: none;\n  }\n}\nbody {\n  background: var(--fond);\n  background-attachment: fixed;\n  color: var(--encre);\n  font-family: var(--police-texte);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n@supports (color: color-mix(in oklab, red, red)) {\n  body {\n    background-image: radial-gradient( 70rem 42rem at 88% -12%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70% ), radial-gradient( 54rem 34rem at -10% 8%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 72% );\n  }\n}\n@media (max-width: 767px) {\n  body {\n    background-attachment: scroll;\n  }\n}\n.apparence {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.min-h-dvh {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.apercu-bandeau {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  padding: 0.5rem 1rem;\n  background: var(--accent);\n  color: var(--sur-accent);\n  font-size: 0.875rem;\n  font-weight: 600;\n}\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--police-titre);\n  font-weight: var(--graisse-titre);\n  letter-spacing: var(--interlettrage-titre);\n  text-wrap: balance;\n}\np {\n  text-wrap: pretty;\n}\n::selection {\n  background: var(--accent);\n  color: var(--sur-accent);\n}\ncode, pre, kbd, samp {\n  font-family: var(--police-mono);\n}\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n  border-radius: 0.5rem;\n}\n@layer components {\n  .ui-carte {\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    padding: var(--espace-carte);\n    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n  }\n  .ui-carte--liee:hover {\n    border-color: var(--accent);\n    @supports (color: color-mix(in lab, red, red)) {\n      border-color: color-mix(in oklab, var(--accent) 45%, var(--bordure));\n    }\n    box-shadow: var(--ombre-elevee);\n    transform: translateY(-2px);\n  }\n  .ui-verre {\n    background: var(--surface);\n    @supports (color: color-mix(in lab, red, red)) {\n      background: color-mix(in oklab, var(--surface) 78%, transparent);\n    }\n    backdrop-filter: blur(18px) saturate(140%);\n    -webkit-backdrop-filter: blur(18px) saturate(140%);\n  }\n  .ui-orb {\n    position: absolute;\n    border-radius: 999px;\n    background: var(--accent);\n    filter: blur(64px);\n    opacity: 0.16;\n    pointer-events: none;\n  }\n  .ui-surtitre {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.6rem;\n    color: var(--accent);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n  .ui-surtitre::before {\n    content: \"\";\n    width: 1.75rem;\n    height: 1px;\n    background: currentColor;\n    opacity: 0.7;\n  }\n  .ui-carte--p4 {\n    padding: 1rem;\n  }\n  .ui-photo img {\n    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  @media (hover: hover) and (prefers-reduced-motion: no-preference) {\n    .ui-photo:hover img {\n      transform: scale(1.045);\n    }\n  }\n  .ui-carte--p5 {\n    padding: 1.25rem;\n  }\n  .ui-carte--p6 {\n    padding: var(--espace-carte);\n  }\n  .ui-carte--plate {\n    box-shadow: none;\n  }\n  .ui-carte--media {\n    padding: 0;\n  }\n  .ui-section {\n    display: flex;\n    flex-direction: column;\n    gap: var(--espace-section);\n  }\n  .ui-bouton {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.5rem;\n    min-height: var(--hauteur-controle);\n    padding: 0.5rem 1.15rem;\n    border: var(--bordure-largeur) solid transparent;\n    border-radius: var(--rayon-bouton);\n    background: transparent;\n    color: var(--encre);\n    font-family: var(--police-texte);\n    font-size: 0.875rem;\n    font-weight: 600;\n    line-height: 1.2;\n    text-align: center;\n    cursor: pointer;\n    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;\n  }\n  .ui-bouton:hover {\n    transform: translateY(-1px);\n  }\n  .ui-bouton:disabled, .ui-bouton[aria-disabled=\"true\"] {\n    opacity: 0.55;\n    cursor: not-allowed;\n    transform: none;\n  }\n  .ui-bouton--primaire {\n    background: var(--accent);\n    color: var(--sur-accent);\n    border-color: var(--accent);\n  }\n  .ui-bouton--primaire:hover {\n    background: var(--accent-fonce);\n    border-color: var(--accent-fonce);\n  }\n  .ui-bouton--encre {\n    background: var(--encre);\n    color: var(--fond);\n    border-color: var(--encre);\n  }\n  .ui-bouton--secondaire {\n    background: var(--surface);\n    color: var(--encre);\n    border-color: var(--bordure);\n  }\n  .ui-bouton--secondaire:hover {\n    background: var(--surface-2);\n  }\n  .ui-bouton--fantome {\n    background: transparent;\n    color: var(--encre);\n    border-color: transparent;\n  }\n  .ui-bouton--fantome:hover {\n    background: var(--surface-2);\n  }\n  .ui-bouton--danger {\n    background: var(--danger);\n    color: #ffffff;\n    border-color: var(--danger);\n  }\n  .ui-bouton--petit {\n    min-height: 2.25rem;\n    padding: 0.35rem 0.8rem;\n    font-size: 0.8125rem;\n  }\n  .ui-bouton--large {\n    width: 100%;\n  }\n  .ui-champ {\n    width: 100%;\n    min-height: var(--hauteur-controle);\n    padding: 0.5rem 0.75rem;\n    background: var(--fond);\n    color: var(--encre);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    font-family: var(--police-texte);\n    font-size: 0.875rem;\n  }\n  .ui-champ:focus-visible {\n    border-color: var(--accent);\n  }\n  .ui-champ[aria-invalid=\"true\"] {\n    border-color: var(--danger);\n  }\n  .ui-label {\n    display: block;\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: var(--encre);\n  }\n  .ui-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.35rem;\n    padding: 0.2rem 0.65rem;\n    border-radius: 999px;\n    background: var(--surface-2);\n    color: var(--encre-douce);\n    font-size: 0.75rem;\n    font-weight: 600;\n    line-height: 1.4;\n  }\n  .ui-badge--accent {\n    background: var(--accent-douce);\n    color: var(--accent);\n  }\n  .ui-badge--ok {\n    background: var(--ok-douce);\n    color: var(--ok);\n  }\n  .ui-badge--alerte {\n    background: var(--alerte-douce);\n    color: var(--alerte);\n  }\n  .ui-badge--danger {\n    background: var(--danger-douce);\n    color: var(--danger);\n  }\n  .ui-alerte {\n    padding: 0.9rem 1rem;\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    background: var(--surface);\n    color: var(--encre);\n    font-size: 0.875rem;\n  }\n  .ui-alerte--ok {\n    background: var(--ok-douce);\n    border-color: var(--ok);\n    color: var(--ok);\n  }\n  .ui-alerte--succes {\n    background: var(--ok-douce);\n    border-color: var(--ok);\n    color: var(--ok);\n  }\n  .ui-etiquette, .ui-etiquette-ui {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 2rem;\n    padding: 0.25rem 0.75rem;\n    border: var(--bordure-largeur) solid transparent;\n    border-radius: 999px;\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-decoration: none;\n  }\n  .ui-etiquette-ui {\n    background: var(--surface);\n    border-color: var(--bordure);\n    color: var(--encre-douce);\n  }\n  .ui-etiquette-ui:hover {\n    border-color: var(--accent);\n    color: var(--accent);\n  }\n  .ui-champ-groupe {\n    display: flex;\n    flex-direction: column;\n    gap: 0.4rem;\n  }\n  .ui-alerte--alerte {\n    background: var(--alerte-douce);\n    border-color: var(--alerte);\n    color: var(--alerte);\n  }\n  .ui-alerte--danger {\n    background: var(--danger-douce);\n    border-color: var(--danger);\n    color: var(--danger);\n  }\n  .ui-nav {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.35rem;\n    padding: 0.35rem;\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-bouton);\n    background: var(--surface);\n  }\n  .ui-nav-lien {\n    display: inline-flex;\n    align-items: center;\n    min-height: 2.25rem;\n    padding: 0.35rem 0.9rem;\n    border-radius: var(--rayon-bouton);\n    color: var(--encre-douce);\n    font-size: 0.875rem;\n    font-weight: 600;\n    text-decoration: none;\n    transition: background-color 160ms ease, color 160ms ease;\n  }\n  .ui-nav-lien:hover {\n    background: var(--surface-2);\n    color: var(--encre);\n  }\n  .ui-nav-lien[aria-current=\"page\"] {\n    background: var(--encre);\n    color: var(--fond);\n  }\n  [data-nav=\"souligne\"] .ui-nav {\n    border: 0;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    border-radius: 0;\n    padding: 0;\n    background: transparent;\n    gap: 1.25rem;\n  }\n  [data-nav=\"souligne\"] .ui-nav-lien {\n    border-radius: 0;\n    padding: 0.65rem 0;\n    border-bottom: 2px solid transparent;\n  }\