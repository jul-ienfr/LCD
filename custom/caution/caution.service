# custom/caution/caution.service — systemd (même LXC que ics-sync, P2-11).
[Unit]
Description=LCD caution + taxe CASA (P2-11) — hold 500-800 EUR + calcul taxe
After=network-online.target facturation.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/lcd/caution/caution.py --config /opt/lcd/caution/config.yaml --logements /opt/lcd/logements.yaml --serve
Environment=LCD_SECRETS_YAML=/opt/lcd/secrets.yaml
Restart=on-failure
RestartSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
