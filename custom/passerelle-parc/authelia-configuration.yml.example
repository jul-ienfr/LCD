# Authelia — seul point d'authentification de la passerelle parc.
#
# Arbre à 1 Go (VPS minimal) : Authelia (~50 Mo résident) est préféré à
# Authentik (300-500 Mo) — §16.4. On bascule sur Authentik SEULEMENT si le VPS
# passe à ≥ 2 Go ET qu'un besoin réel d'OIDC multi-app apparaît.
#
# Aucun mot de passe, aucun digest dans ce fichier : les comptes vivent dans
# /etc/authelia/users_docker.yml, généré par `deploy-vps.sh authelia-users`
# (hashés en argon2id par `authelia hash-password`, jamais écrits dans le repo).

server:
  address: 'unix:///var/run/authelia/authelia.sock'   # pas de TCP exposé par Authelia
  buffers:
    read: 8192

log:
  level: 'info'          # jamais 'debug' en prod : debug trace les sessions
  file_path: '/var/log/authelia/authelia.log'
  keep_stdout: false

authentication_backend:
  password_reset:
    disable: true        # pas de reset libre : MFA + compte créé par admin (§4)
  file:
    path: /etc/authelia/users_docker.yml
    password:
      algorithm: 'argon2id'
      # Cohérence VPS ↔ box : argon2id côté VPS, scrypt côté box proche.
      # Si le VPS est à 1 Go, argon2id à 64 Mo suffit (voir Paramètres du coffre).
      argon2id:
        iterations: 3
        memory: 65536
        parallelism: 4
        key_length: 32
        salt_length: 16
  refresh_interval: '5m'   # révocation d'un compte visible sous 5 min côté SSO

access_control:
  default_policy: 'deny'    # rien n'entre sans règle explicite
  rules:
    # Page parc + écritures 1-tap : tout humain avec un compte Authelia.
    # La gateway refait SON contrôle RBAC (rôle, périmètre, révocation) sur
    # chaque action : Authelia prouve l'identité, il n'autorise rien de métier.
    - domain: 'parc.*'
      policy: 'one_factor'
    # admin/super_admin : 2e facteur obligatoire (MFA §4 — intangible).
    - domain: 'parc.*'
      subject: 'group:parc_admin'
      policy: 'two_factor'
    # Santé interne : jamais exposé via Caddy (réservé au réseau WireGuard).
    - domain: '10.99.0.1'
      policy: 'bypass'

session:
  name: 'authelia_session'
  secret: __LCD_AUTHELIA_SESSION_SECRET__   # rempli par deploy-vps.sh, jamais en dur
  expiration: '1h'
  inactivity: '15m'
  remember_me_duration: '30d'
  cookies:
    - domain: __LCD_ZONE__
      authelia_url: 'https://authelia.{$ZONE}'
      default_redirection_url: 'https://parc.{$ZONE}'
      same_site: 'lax'
      http_only: true

storage:
  encryption_key: __LCD_AUTHELIA_STORAGE_KEY__   # idem : vault age uniquement
  local:
    path: '/var/lib/authelia/db.sqlite3'

notifier:
  filesystem:
    filename: '/var/lib/authelia/notification.txt'   # 0 dépendance SMTP
  # SMTP (optionnel, à activer avec les identifiants du coffre-fort) :
  # smtp:
  #   host: '__LCD_SMTP_HOST__'
  #   port: 587
  #   sender: '__LCD_SMTP_SENDER__'
  #   username: '__LCD_SMTP_USER__'
  #   password: '__LCD_SMTP_PASSWORD__'   # chiffré, monté depuis le vault

regulation:
  max_retries: 3
  find_time: '5m'
  ban_time: '15m'

password_policy: 'standard'   # pas de politique custom faite maison

totp:
  issuer: 'Parc'
  # Fenêtre large : horloge VPS/box décalée de ±5 min tolérée (§16.5).
  period: 30
  skew: 2
  algorithm: 'sha1'
  digits: 6
