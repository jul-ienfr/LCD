    "db:test-rls": "node scripts/verifier-rls.mjs",
    "db:test-mappings": "node scripts/verifier-mappings-fournisseurs.mjs",
    "db:test-ics": "tsx --env-file-if-exists=.env.local scripts/test-sync-ics.ts",
    "db:test-migrations": "node scripts/test-migrations.mjs",
    "preflight": "tsx scripts/preflight.ts",
    "smoke": "node scripts/smoke.mjs",
    "recette:publique": "node scripts/recette-publique.mjs",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "db:nettoyer-recette": "node scripts/nettoyer-donnees-recette.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore-test": "node scripts/restore-test.mjs",
    "db:verifier-hors-site": "node scripts/verifier-sauvegarde-externe.mjs",
    "db:purge-blobs": "tsx --env-file-if-exists=.env.local scripts/purger-blobs.ts",
    "mcp:lecture": "tsx scripts/mcp-lecture.ts",
    "db:purge-suivi": "tsx --env-file-if-exists=.env.local scripts/purger-suivi.ts",
    "migration:inventaire": "tsx scripts/migration-v1/inventaire.ts",
    "migration:simulation": "tsx scripts/migration-v1/importer.ts --simulation",
    "migration:appliquer": "tsx scripts/migration-v1/importer.ts --appliquer",
    "audit:a11y:verifier": "node scripts/audit-a11y.mjs --verifier"
