: #0b0e14;\n    --surface: #131826;\n    --surface-2: #1a2132;\n    --bordure: #263049;\n    --encre: #eef1f7;\n    --encre-douce: #c2cad8;\n    --encre-faine: #8a94a8;\n    --accent: #2dd4a8;\n    --accent-fonce: #5ee8c0;\n    --accent-douce: #0e2b25;\n    --sur-accent: #0b0e14;\n    --ok: #4ade80;\n    --ok-douce: #0f2c1c;\n    --alerte: #fbbf24;\n    --alerte-douce: #2e230c;\n    --danger: #f87171;\n    --danger-douce: #2e1414;\n    --ombre-carte: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 28px rgb(0 0 0 / 0.45);\n    --ombre-elevee: 0 16px 48px rgb(0 0 0 / 0.55);\n  }\n}\nhtml.theme-clair {\n  color-scheme: light;\n}\nhtml.theme-sombre {\n  color-scheme: dark;\n}\nhtml {\n  scroll-behavior: smooth;\n}\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n  .ui-bouton, .ui-carte, .ui-tableau tbody tr {\n    transition: none;\n  }\n  .ui-bouton:hover, .ui-carte--liee:hover {\n    transform: none;\n  }\n}\nbody {\n  background: var(--fond);\n  background-attachment: fixed;\n  color: var(--encre);\n  font-family: var(--police-texte);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n@supports (color: color-mix(in oklab, red, red)) {\n  body {\n    background-image: radial-gradient( 70rem 42rem at 88% -12%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70% ), radial-gradient( 54rem 34rem at -10% 8%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 72% );\n  }\n}\n@media (max-width: 767px) {\n  body {\n    background-attachment: scroll;\n  }\n}\n.apparence {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.min-h-dvh {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.apercu-bandeau {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  padding: 0.5rem 1rem;\n  background: var(--accent);\n  color: var(--sur-accent);\n  font-size: 0.875rem;\n  font-weight: 600;\n}\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--police-titre);\n  font-weight: var(--graisse-titre);\n  letter-spacing: var(--interlettrage-titre);\n  text-wrap: balance;\n}\np {\n  text-wrap: pretty;\n}\n::selection {\n  background: var(--accent);\n  color: var(--sur-accent);\n}\ncode, pre, kbd, samp {\n  font-family: var(--police-mono);\n}\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n  border-radius: 0.5rem;\n}\n@layer components {\n  .ui-carte {\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    padding: var(--espace-carte);\n    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n  }\n  .ui-carte--liee:hover {\n    border-color: var(--accent);\n    @supports (color: color-mix(in lab, red, red)) {\n      border-color: color-mix(in oklab, var(--accent) 45%, var(--bordure));\n    }\n    box-shadow: var(--ombre-elevee);\n    transform: translateY(-2px);\n  }\n  .ui-verre {\n    background: var(--surface);\n    @supports (color: color-mix(in lab, red, red)) {\n      background: color-mix(in oklab, var(--surface) 78%, transparent);\n    }\n    backdrop-filter: blur(18px) saturate(140%);\n    -webkit-backdrop-filter: blur(18px) saturate(140%);\n  }\n  .ui-orb {\n    position: absolute;\n    border-radius: 999px;\n    background: var(--accent);\n    filter: blur(64px);\n    opacity: 0.16;\n    pointer-events: none;\n  }\n  .ui-surtitre {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.6rem;\n    color: var(--accent);\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n  }\n  .ui-surtitre::before {\n    content: \"\";\n    width: 1.75rem;\n    height: 1px;\n    background: currentColor;\n    opacity: 0.7;\n  }\n  .ui-carte--p4 {\n    padding: 1rem;\n  }\n  .ui-photo img {\n    transition: transform 700ms cubic-bezier(0.22, 1