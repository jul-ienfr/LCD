rem;\n    padding: 0.35rem 0.8rem;\n    font-size: 0.8125rem;\n  }\n  .ui-bouton--large {\n    width: 100%;\n  }\n  .ui-champ {\n    width: 100%;\n    min-height: var(--hauteur-controle);\n    padding: 0.5rem 0.75rem;\n    background: var(--fond);\n    color: var(--encre);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    font-family: var(--police-texte);\n    font-size: 0.875rem;\n  }\n  .ui-champ:focus-visible {\n    border-color: var(--accent);\n  }\n  .ui-champ[aria-invalid=\"true\"] {\n    border-color: var(--danger);\n  }\n  .ui-label {\n    display: block;\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: var(--encre);\n  }\n  .ui-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.35rem;\n    padding: 0.2rem 0.65rem;\n    border-radius: 999px;\n    background: var(--surface-2);\n    color: var(--encre-douce);\n    font-size: 0.75rem;\n    font-weight: 600;\n    line-height: 1.4;\n  }\n  .ui-badge--accent {\n    background: var(--accent-douce);\n    color: var(--accent);\n  }\n  .ui-badge--ok {\n    background: var(--ok-douce);\n    color: var(--ok);\n  }\n  .ui-badge--alerte {\n    background: var(--alerte-douce);\n    color: var(--alerte);\n  }\n  .ui-badge--danger {\n    background: var(--danger-douce);\n    color: var(--danger);\n  }\n  .ui-alerte {\n    padding: 0.9rem 1rem;\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    background: var(--surface);\n    color: var(--encre);\n    font-size: 0.875rem;\n  }\n  .ui-alerte--ok {\n    background: var(--ok-douce);\n    border-color: var(--ok);\n    color: var(--ok);\n  }\n  .ui-alerte--succes {\n    background: var(--ok-douce);\n    border-color: var(--ok);\n    color: var(--ok);\n  }\n  .ui-etiquette, .ui-etiquette-ui {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 2rem;\n    padding: 0.25rem 0.75rem;\n    border