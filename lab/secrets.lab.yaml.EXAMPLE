# lab/secrets.lab.yaml.EXAMPLE — gabarit versionné. Copier vers secrets.lab.yaml
# (gitignoré, JAMAIS commité) et y mettre des valeurs FAUSSES de lab uniquement.
# JAMAIS de clés réelles ici : la règle persistante l'interdit
# (secrets/clés API dans secrets.yaml, jamais commitées).
ha_api_token: "CHANGER-LAB-TOKEN-HA"  # préfixe CHANGER obligatoire : en lab les
  # moteurs forgent un JWT vers la box virtuelle (box = vrai token Bearer ici)
qloapps_webservice_key: "LAB-FAUSSE-cle-qloapps"
swikly_api_key: "LAB-FAUSSE-cle-swikly"
stripe_secret_key: "sk_test_LAB_FAUX"
# P6-10 §5.10 : SSID + clé WiFi invité FAUSSES de lab (copier + renseigner
# en FAUX dans secrets.lab.yaml gitignoré ; box = vraies valeurs P1-9/secrets).
wifi_log1_ssid: "LCD-LAB-Guest-log1"
wifi_log1_key: "LAB-FAUSSE-cle-wifi-log1"
wifi_log2_ssid: "LCD-LAB-Guest-log2"
wifi_log2_key: "LAB-FAUSSE-cle-wifi-log2"
