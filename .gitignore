# LCD — jamais commité (privé / runtime / secrets)
# Versionné : code + *.example + docs/templates/ seuls.

# Secrets — jamais commités (P1-9)
secrets.yaml
custom/branding.yaml
!custom/branding.yaml.example

# Instances privées par logement / parc (P1-7)
docs/log1/
docs/log2/
docs/parc/
docs/strategie-famille/
!docs/templates/

# Runtime HA /config/ — backup chiffré quotidien + hebdo hors site (P1-1)
/config/
*.log
*.jsonl

# Backups / images / coordinator
*.backup
*.tar
backups/
coordinator_backup.json

# Runtime moteurs locaux custom/* (P2 — JAMAIS commité : brouillons, ICS, JSONL)
custom/*/state/
lab/*state*/
lab/secrets.lab.yaml
lab/*.log
# Registres lab ÉCRITS par le CRUD /parc/* et /parc/annonces/* (copies dédiées,
# jamais logements.yaml). Les modèles (locations.modele.yaml, annonces.modele.yaml)
# sont VERSIONNÉS : ils servent de référence remise à zéro en tête de §56/§57.
# Les snapshots horodatés vivent dans le volume passerelle-state, pas ici.
lab/parc-registre/*.yaml
!lab/parc-registre/locations.yaml
!lab/parc-registre/locations.modele.yaml
!lab/parc-registre/annonces.yaml
!lab/parc-registre/annonces.modele.yaml
!lab/parc-registre/entites.yaml
!lab/parc-registre/entites.modele.yaml
!lab/parc-registre/mandats.yaml
!lab/parc-registre/mandats.modele.yaml
!lab/parc-registre/prospects.yaml
!lab/parc-registre/prospects.modele.yaml
state-test-*/
# Ancien emplacement racine (passerelle-parc avant résolution par config) :
/state/
*.pid
__pycache__/
*.pyc

# Frontend web/ (Next.js, déployable Vercel + self-hosted Docker — jamais
# commité : build + deps + types générés ; le LOCK est versionné pour des
# builds reproductibles locaux + CI + Docker, jamais de `npm install` flottant)
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp
*~

# Outillage local (config machine, audits locaux — jamais versionnés)
.claude/*
# Skills replica (radar concurrentiel §S10 — versionnés, MIT, outillage lab)
!.claude/skills/
!.claude/skills/**
