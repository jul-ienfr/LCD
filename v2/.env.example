# Copier vers .env.local (jamais commité).
# Les valeurs ci-dessous sont des défauts de DÉVELOPPEMENT uniquement.

APP_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL local (docker compose -f compose.dev.yml up -d)
# Développement : le owner suffit. En production, DATABASE_URL pointe vers le
# rôle applicatif non-propriétaire et MIGRATION_DATABASE_URL vers le owner.
DATABASE_URL=postgres://lcd:lcd@127.0.0.1:5432/lcd
# MIGRATION_DATABASE_URL=postgres://lcd:lcd@127.0.0.1:5432/lcd
# APP_ROLE_NAME=lcd_app
# APP_ROLE_PASSWORD=

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev-only-change-me-please-32chars-min
BETTER_AUTH_URL=http://localhost:5173
# URLs supplémentaires autorisées (previews), séparées par des virgules.
BETTER_AUTH_TRUSTED_ORIGINS=
# E-mails d'exploitation traités comme super-admin sans modification en base.
SUPER_ADMIN_EMAILS=

# Médiation de la consommation (facultatif tant que non désigné).
# Renseigner au minimum MEDIATEUR_NOM pour l'afficher sur /legales et les factures.
MEDIATEUR_NOM=
MEDIATEUR_URL=
MEDIATEUR_ADRESSE=

# Seed admin (développement uniquement — changer avant tout déploiement)
SEED_ADMIN_EMAIL=admin@lcd.test
SEED_ADMIN_PASSWORD=ChangeMe-2026!
# Compte super-admin dédié (thème global, supervision). À défaut, le compte
# admin ci-dessus est promu super_admin au seed.
SEED_SUPER_ADMIN_EMAIL=superadmin@lcd.test
SEED_SUPER_ADMIN_PASSWORD=ChangeMe-2026!
SEED_PRESTA_EMAIL=presta@lcd.test
SEED_PRESTA_PASSWORD=ChangeMe-2026!
SEED_PROPRIO_EMAIL=proprio@lcd.test
SEED_PROPRIO_PASSWORD=ChangeMe-2026!
SEED_COMMERCIAL_EMAIL=commercial@lcd.test
SEED_COMMERCIAL_PASSWORD=ChangeMe-2026!
SEED_TENANT_SLUG=lcd

# Stockage S3-compatible (MinIO local)
# Stockage local des photos de preuve (volume persistant en production).
STOCKAGE_LOCAL_DIR=.data/photos
BODY_SIZE_LIMIT=12M

# Supervision : seuils d'alerte et jeton du heartbeat box terrain.
ALERTE_DISQUE_GO=2
ALERTE_TLS_JOURS=14
BOX_HEARTBEAT_MAX_MINUTES=15
BOX_TOKEN=
# Jeton du moniteur HTTP (Uptime Kuma) pour /api/health/systeme.
HEALTH_TOKEN=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=lcd
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Email (Mailpit local ou Brevo en beta)
EMAIL_ENABLED=true
EMAIL_FROM=LCD <no-reply@lcd.test>
SMTP_URL=smtp://127.0.0.1:1025

# SMS transactionnels Brevo (facultatif, désactivé par défaut).
SMS_ENABLED=false
BREVO_API_KEY=
BREVO_SMS_SENDER=LCD

# Sauvegardes locales (facultatif) — clé base64 32 octets
BACKUP_ENCRYPTION_KEY=

# Paiement (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assistant LLM (facultatif) : endpoint OpenAI-compatible complet.
# Sans URL/clé, l’assistant utilise le générateur local déterministe.
# Ex. https://api.openai.com/v1/chat/completions ou http://127.0.0.1:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Modèle utilisé pour l’intention « avis » avec ton chaleureux.
LLM_MODEL_PREMIUM=

# Cron OTA (facultatif)
CRON_SECRET=
# Synchronisation ICS in-process : false en développement, true sur un serveur
# persistant (VPS, Docker). Laisser false sur Netlify/Vercel : le cron HTTP ou
# GitHub Actions prend le relais.
ICS_SCHEDULER_ENABLED=false
ICS_SYNC_INTERVAL_MINUTES=5
ICS_SYNC_CONCURRENCE=4
ICS_SYNC_TIMEOUT_MS=12000
ICS_SYNC_TICK_SECONDS=30
ICS_SYNC_MAX_FLUX_PAR_CYCLE=100
ICS_SYNC_LEASE_MINUTES=10
# Relances automatiques (J+1, J+7, J+15, J+30), false par défaut.
RELANCE_AUTO_ENABLED=false

# Fournisseurs channel manager (facultatif). Les clés restent côté serveur.
# Beds24 : jeton long = lecture seule ; refresh token = écriture ARI.
BEDS24_API_TOKEN=
BEDS24_REFRESH_TOKEN=
BEDS24_WEBHOOK_SECRET=
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
SMOOBU_WEBHOOK_SECRET=
HOSTPORT_API_KEY=
HOSTPORT_WEBHOOK_SECRET=
NOBEDS_API_TOKEN=
NOBEDS_WEBHOOK_SECRET=
# Bases de staging surchargeables :
# CHANNEX_API_BASE=https://staging.channex.io/api/v1
FOURNISSEUR_HTTP_TIMEOUT_MS=12000
# Synchronisation automatique : désactivée par défaut sur un serveur
# persistant, utilisez /api/cron/sync-fournisseurs avec CRON_SECRET.
FOURNISSEUR_SYNC_ENABLED=false
FOURNISSEUR_SYNC_INTERVAL_MINUTES=15
FOURNISSEUR_SYNC_TICK_SECONDS=300
FOURNISSEUR_SYNC_CONCURRENCE=2
FOURNISSEUR_SYNC_MAX_LOGEMENTS=200
FOURNISSEUR_SYNC_LEASE_MINUTES=10
FOURNISSEUR_SYNC_HORIZON_JOURS=365
FOURNISSEUR_SYNC_PAST_DAYS=365
FOURNISSEUR_HOSTPORT_INTERVAL_MINUTES=60
FOURNISSEUR_NOBEDS_INTERVAL_MINUTES=240
FOURNISSEUR_WEBHOOK_MAX_LOGEMENTS=20

# Connecteurs runtime box (facultatif) : JSON indexé par boxId.
# Ex. {"log1":{"type":"home_assistant","baseUrl":"https://ha.local","token":"..."}}
BOX_RUNTIME_CONFIG=

# Observabilité (facultatif)
SENTRY_DSN=
METRICS_TOKEN=
AUTH_2FA_REQUIRED=false

# Marque blanche (facultatif). Re-thème sans rebuild : redémarrer le serveur.
MARQUE=
MARQUE_COURTE=
MARQUE_SLUG=
