# Passerelle parc — VPS public. Caddy v2, face utilisateur.
#
# INTANGIBLE (plan §1 + §13) : ne JAMAIS publier les ports du socle.
# Interdits ici, et nulle part ailleurs sur ce VPS :
#   :8123 Home Assistant | :4000 llm-proxy | :8050 llm-router-ui |
#   :8090-8100 moteurs | :8060 dashboard-hote
# Ils restent joignables UNIQUEMENT depuis le réseau WireGuard (box → VPS),
# cf. boxes.yaml : les endpoints pointent en 10.99.0.0/24, jamais en 127.0.0.1.
# Test de non-régression : lab/tests_lab.py §52 interdit qu'un de ces numéros
# réapparaisse dans ce fichier.
#
# Rien n'est en clair dans ce fichier : tous les secrets vivent dans
# /etc/lcd/vault (chiffré age, §7), monté au démarrage par deploy-vps.sh.

{
	# Contact ACME (Let's Encrypt). Mettre l'email du super_admin réel.
	email {$ADMIN_EMAIL:admin@example.local}
	# Pas de TLS interne sur le réseau WireGuard : c'est mTLS moteur à moteur
	# (boxes.yaml, G3 avec step-ca) — on ne double pas le chiffrement.
}

(entetes_communs) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
	# Pas de cache sur la page parc : les prix bougent (TTL 90 s côté gateway).
	header Cache-Control "no-store"
}

# ---------------------------------------------------------------------------
# Face utilisateur : UNE seule origine publique, derrière Authelia.
# ---------------------------------------------------------------------------
https://parc.{$ZONE} {
	import entetes_communs

	# Authentification AVANT tout rendu (401 sans session valide).
	# `copy_headers` ne sert qu'à journaliser : la gateway refait SON contrôle
	# RBAC sur chaque écriture (§4) — elle ne fait jamais confiance à l'en-tête.
	forward_auth authelia:9091 {
		uri /api/verify?auth=basic&trusted_uris=https://parc.{$ZONE}/v1/action
		copy_headers Remote-User Remote-Groups Remote-Name
	}

	reverse_proxy gateway-parc:8443 {
		header_up X-Forwarded-Proto https
		# Le parc n'a pas de session applicative : pas de cookie côté gateway.
		header_up -Authorization
	}
}

# §16.3 : domaines wildcard LE (`sejour./parc./api.<domaine>`, TTL court pour
# bascule). `sejour.` = PWA voyageur (lecture + 1-tap contrat), `api.` = fan-out
# boxes/moteurs via WG (jamais WAN direct) — même garde Authelia, aucun port du
# socle publié. Activer en G3 réel (DNS + `deploy-vps.sh init`).
