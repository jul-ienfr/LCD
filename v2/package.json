  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.14",
    "bits-ui": "2.20.2",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "postgres": "4.1.1",
