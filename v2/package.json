{
  "name": "lcd-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "measure:js": "node scripts/measure-js.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:role-app": "node scripts/creer-role-app.mjs",
    "db:test-rls": "node scripts/verifier-rls.mjs",
    "db:test-mappings": "node scripts/verifier-mappings-fournisseurs.mjs",
    "db:test-ics": "tsx --env-file-if-exists=.env.local scripts/test-sync-ics.ts",
    "db:test-migrations": "node scripts/test-migrations.mjs",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore-test": "node scripts/restore-test.mjs",
    "db:purge-blobs": "tsx --env-file-if-exists=.env.local scripts/purger-blobs.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.14",
    "bits-ui": "2.20.2",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
