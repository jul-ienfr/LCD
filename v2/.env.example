# Copier vers .env.local (jamais commité).
# Les valeurs ci-dessous sont des défauts de DÉVELOPPEMENT uniquement.

APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL local (docker compose -f compose.dev.yml up -d)
DATABASE_URL=postgres://lcd:lcd@127.0.0.1:5432/lcd

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev-only-change-me-please-32chars-min
BETTER_AUTH_URL=http://localhost:3000
# URLs supplémentaires autorisées (previews Netlify), séparées par des virgules.
BETTER_AUTH_TRUSTED_ORIGINS=

# Seed admin (développement uniquement — changer avant tout déploiement)
SEED_ADMIN_EMAIL=admin@lcd.test
SEED_ADMIN_PASSWORD=ChangeMe-2026!
SEED_PRESTA_EMAIL=presta@lcd.test
SEED_PRESTA_PASSWORD=ChangeMe-2026!
SEED_TENANT_SLUG=lcd

# Stockage S3-compatible (MinIO local)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=lcd
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# Email (Mailpit local ou Brevo en beta)
EMAIL_FROM=LCD <no-reply@lcd.test>
SMTP_URL=smtp://127.0.0.1:1025

# Paiement (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observabilité (facultatif)
SENTRY_DSN=
