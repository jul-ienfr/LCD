cent-fonce: #5ee8c0;\n    --accent-douce: #0e2b25;\n    --sur-accent: #0b0e14;\n    --ok: #4ade80;\n    --ok-douce: #0f2c1c;\n    --alerte: #fbbf24;\n    --alerte-douce: #2e230c;\n    --danger: #f87171;\n    --danger-douce: #2e1414;\n    --ombre-carte: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 28px rgb(0 0 0 / 0.45);\n    --ombre-elevee: 0 16px 48px rgb(0 0 0 / 0.55);\n  }\n}\nhtml.theme-clair {\n  color-scheme: light;\n}\nhtml.theme-sombre {\n  color-scheme: dark;\n}\nhtml {\n  scroll-behavior: smooth;\n}\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n  .ui-bouton, .ui-carte, .ui-tableau tbody tr {\n    transition: none;\n  }\n  .ui-bouton:hover, .ui-carte--liee:hover {\n    transform: none;\n  }\n}\nbody {\n  background: var(--fond);\n  background-attachment: fixed;\n  color: var(--encre);\n  font-family: var(--police-texte);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n@supports (color: color-mix(in oklab, red, red)) {\n  body {\n    background-image: radial-gradient( 70rem 42rem at 88% -12%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70% ), radial-gradient( 54rem 34rem at -10% 8%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 72% );\n  }\n}\n@media (max-width: 767px) {\n  body {\n    background-attachment: scroll;\n  }\n}\n.apparence {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.min-h-dvh {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.apercu-bandeau {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  padding: 0.5rem 1rem;\n  background: var(--accent);\n  color: var(--sur-accent);\n  font-size: 0.875rem;\n  font-weight: 600;\n}\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--police-titre);\n  font-weight: var(--graisse-titre);\n  letter-spacing: var(--interlettrage-titre);\n  text-wrap: balance;\n}\np {\n  text-wrap: pretty;\n}\n::selecti