# Copier vers .env.prod sur le serveur, puis remplir les valeurs.
# Ne jamais committer .env.prod.

# Domaine public (DNS A/AAAA doit pointer vers le VPS).
DOMAIN=lcd.example.fr

# PostgreSQL interne au compose.
POSTGRES_USER=lcd
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24
POSTGRES_DB=lcd
# Le mot de passe doit être identique à POSTGRES_PASSWORD.
DATABASE_URL=postgres://lcd:change-me-with-openssl-rand-hex-24@postgres:5432/lcd

# URL publiques
APP_URL=https://lcd.example.fr
BETTER_AUTH_URL=https://lcd.example.fr
BETTER_AUTH_SECRET=change-me-with-openssl-rand-hex-32
BETTER_AUTH_TRUSTED_ORIGINS=

# Email (désactivé tant qu'aucun SMTP de production n'est configuré)
EMAIL_ENABLED=false
EMAIL_FROM=LCD Parc <no-reply@lcd.example.fr>
SMTP_URL=

# Paiement (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cron OTA + webhooks
CRON_SECRET=change-me-with-openssl-rand-hex-32

# Observabilité (facultatif)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Seed admin : uniquement pour la première initialisation, à retirer ensuite.
SEED_ADMIN_EMAIL=admin@lcd.example.fr
SEED_ADMIN_PASSWORD=change-me-with-at-least-12-chars
SEED_TENANT_SLUG=lcd
