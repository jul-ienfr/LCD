# 		copy_headers Remote-User Remote-Groups Remote-Name
# 	}
# 	reverse_proxy gateway-parc:8443 {
# 		header_up X-Forwarded-Proto https
# 		header_up -Authorization
# 	}
# }

# ---------------------------------------------------------------------------
# Tout le reste du trafic WAN : fermé. Pas de bloc `http://` de repli, pas de
# bloc "santé", pas de bloc debug. Caddy répond le minimum sur :80 (redirection
# HTTPS automatique) puis laisse tomber.
# ---------------------------------------------------------------------------

