# Copier vers .env.prod sur le serveur, puis remplir les valeurs.
# Ne jamais committer .env.prod.

# Domaine public (DNS A/AAAA doit pointer vers le VPS).
DOMAIN=lcd.example.fr

# PostgreSQL interne au compose.
POSTGRES_USER=lcd
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24
POSTGRES_DB=lcd
# Owner : migrations, seed, sauvegardes.
MIGRATION_DATABASE_URL=postgres://lcd:change-me-with-openssl-rand-hex-24@postgres:5432/lcd
# Rôle applicatif non-propriétaire : RLS réellement appliquée.
# Créer le rôle avec `npm run db:role-app` après les migrations.
APP_ROLE_NAME=lcd_app
APP_ROLE_PASSWORD=change-me-app-role-hex-24
DATABASE_URL=postgres://lcd_app:change-me-app-role-hex-24@postgres:5432/lcd

# Photos de preuve : volume persistant monté dans le conteneur.
STOCKAGE_LOCAL_DIR=/var/lib/lcd/photos
# Adapter-node : autorise les uploads jusqu'à 10 Mo + marge multipart.
BODY_SIZE_LIMIT=12M

# Supervision : disque, certificat TLS et heartbeat box.
ALERTE_DISQUE_GO=2
ALERTE_TLS_JOURS=14
BOX_HEARTBEAT_MAX_MINUTES=15
# openssl rand -hex 32
BOX_TOKEN=
HEALTH_TOKEN=

# URL publiques
APP_URL=https://lcd.example.fr
BETTER_AUTH_URL=https://lcd.example.fr
BETTER_AUTH_SECRET=change-me-with-openssl-rand-hex-32
BETTER_AUTH_TRUSTED_ORIGINS=

# Email (désactivé tant qu'aucun SMTP de production n'est configuré)
EMAIL_ENABLED=false
EMAIL_FROM=LCD Parc <no-reply@lcd.example.fr>
SMTP_URL=

# SMS transactionnels Brevo (facultatif)
SMS_ENABLED=false
BREVO_API_KEY=
BREVO_SMS_SENDER=LCD

# Sauvegardes (scripts VPS/GitHub, facultatif) — clé base64 32 octets
BACKUP_ENCRYPTION_KEY=

# Paiement (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assistant LLM (facultatif) : endpoint OpenAI-compatible complet.
# Laisser vide pour le générateur local déterministe.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_PREMIUM=

# Cron OTA + webhooks
CRON_SECRET=change-me-with-openssl-rand-hex-32
# Synchronisation ICS automatique in-process (VPS/Docker uniquement).
# Garder false sur Netlify/Vercel : utiliser le cron HTTP /api/cron/sync-ota.
ICS_SCHEDULER_ENABLED=true
ICS_SYNC_INTERVAL_MINUTES=5
ICS_SYNC_CONCURRENCE=4
ICS_SYNC_TIMEOUT_MS=12000
ICS_SYNC_TICK_SECONDS=30
ICS_SYNC_MAX_FLUX_PAR_CYCLE=100
ICS_SYNC_LEASE_MINUTES=10
# Relances automatiques aux échéances J+1, J+7, J+15, J+30.
RELANCE_AUTO_ENABLED=false

# Fournisseurs channel manager (facultatif). Le super-admin active ensuite
# chaque fournisseur dans Supervision → Fournisseurs.
BEDS24_API_TOKEN=
BEDS24_REFRESH_TOKEN=
BEDS24_WEBHOOK_SECRET=
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
SMOOBU_WEBHOOK_SECRET=
HOSTPORT_API_KEY=
HOSTPORT_WEBHOOK_SECRET=
NOBEDS_API_TOKEN=
NOBEDS_WEBHOOK_SECRET=
FOURNISSEUR_HTTP_TIMEOUT_MS=12000
FOURNISSEUR_SYNC_ENABLED=false
FOURNISSEUR_SYNC_INTERVAL_MINUTES=15
FOURNISSEUR_SYNC_TICK_SECONDS=300
FOURNISSEUR_SYNC_CONCURRENCE=2
FOURNISSEUR_SYNC_MAX_LOGEMENTS=200
FOURNISSEUR_SYNC_LEASE_MINUTES=10
FOURNISSEUR_SYNC_HORIZON_JOURS=365
FOURNISSEUR_SYNC_PAST_DAYS=365
FOURNISSEUR_HOSTPORT_INTERVAL_MINUTES=60
FOURNISSEUR_NOBEDS_INTERVAL_MINUTES=240
FOURNISSEUR_WEBHOOK_MAX_LOGEMENTS=20

# Connecteurs runtime box (facultatif) : JSON indexé par boxId.
BOX_RUNTIME_CONFIG=

# Observabilité (facultatif)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
METRICS_TOKEN=

# Seed admin : uniquement pour la première initialisation, à retirer ensuite.
SEED_ADMIN_EMAIL=admin@lcd.example.fr
SEED_ADMIN_PASSWORD=change-me-with-at-least-12-chars
SEED_TENANT_SLUG=lcd
AUTH_2FA_REQUIRED=true

# Médiation de la consommation (obligatoire après désignation).
MEDIATEUR_NOM=
MEDIATEUR_URL=
MEDIATEUR_ADRESSE=

# Marque blanche (facultatif).
MARQUE=
MARQUE_COURTE=
MARQUE_SLUG=
