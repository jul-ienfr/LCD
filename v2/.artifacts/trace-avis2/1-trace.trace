uligne\"] .ui-nav-lien[aria-current=\"page\"] {\n    background: transparent;\n    color: var(--accent);\n    border-bottom-color: var(--accent);\n  }\n  [data-nav=\"bloc\"] .ui-nav {\n    border: 0;\n    border-radius: 0;\n    padding: 0;\n    background: transparent;\n    gap: 0;\n  }\n  [data-nav=\"bloc\"] .ui-nav-lien {\n    border-radius: 0;\n    padding: 0.65rem 0.9rem;\n    border-right: var(--bordure-largeur) solid var(--bordure);\n  }\n  [data-nav=\"bloc\"] .ui-nav-lien:last-child {\n    border-right: 0;\n  }\n  [data-nav=\"bloc\"] .ui-nav-lien[aria-current=\"page\"] {\n    background: var(--accent);\n    color: var(--sur-accent);\n  }\n  [data-entete=\"centre\"] .ui-entete {\n    text-align: center;\n    align-items: center;\n    margin-inline: auto;\n  }\n  [data-entete=\"editorial\"] .ui-entete h1 {\n    font-size: clamp(2rem, 4vw, 2.75rem);\n    max-width: 22ch;\n  }\n  .ui-kpi {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    gap: 0.25rem;\n    padding: var(--espace-carte);\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    overflow: hidden;\n  }\n  .ui-kpi::before {\n    content: \"\";\n    position: absolute;\n    inset: 0 0 auto;\n    height: 2px;\n    background: linear-gradient(90deg, var(--accent), transparent);\n    opacity: 0.7;\n  }\n  .ui-kpi-valeur {\n    font-family: var(--police-titre);\n    font-size: 1.9rem;\n    font-weight: var(--graisse-titre);\n    letter-spacing: var(--interlettrage-titre);\n    font-variant-numeric: tabular-nums;\n  }\n  .ui-tableau {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.875rem;\n  }\n  .ui-tableau th {\n    text-align: left;\n    padding: 0.75rem 1rem;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    color: var(--encre-faine);\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n  }\n  .ui-tableau td {\n    padding: 0.75rem 1rem;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    vertical-align: top;\n  }\n  .ui-tableau tr:last-child td {\n    border-bottom: 0;\n  }\n  .ui-tableau tbody tr {\n    transition: background-color 140ms ease;\n  }\n  .ui-tableau tbody tr:hover {\n    background: var(--surface-2);\n  }\n  @supports (color: color-mix(in oklab, red, red)) {\n    .ui-tableau tbody tr:hover {\n      background: color-mix(in oklab, var(--accent) 5%, transparent);\n    }\n  }\n  .ui-menu {\n    position: relative;\n  }\n  .ui-menu > summary {\n    list-style: none;\n    cursor: pointer;\n  }\n  .ui-menu > summary::-webkit-details-marker {\n    display: none;\n  }\n  .ui-menu > summary::after {\n    content: \"＋\";\n    font-size: 0.9em;\n    line-height: 1;\n  }\n  .ui-menu[open] > summary::after {\n    content: \"−\";\n  }\n  .ui-menu-panneau {\n    position: absolute;\n    right: 0;\n    top: calc(100% + 0.6rem);\n    z-index: 40;\n    width: min(44rem, calc(100vw - 2rem));\n    max-height: min(32rem, 72dvh);\n    overflow-y: auto;\n    padding: 1.1rem;\n    display: grid;\n    gap: 1rem;\n    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-elevee);\n  }\n  .ui-menu-groupe {\n    display: flex;\n    flex-direction: column;\n    gap: 0.15rem;\n    min-width: 0;\n  }\n  .ui-menu-titre {\n    padding: 0.25rem 0.6rem;\n    color: var(--encre-faine);\n    font-size: 0.6875rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  .ui-menu-lien {\n    padding: 0.45rem 0.6rem;\n    border-radius: 0.5rem;\n    color: var(--encre-douce);\n    font-size: 0.875rem;\n    font-weight: 500;\n    text-decoration: none;\n  }\n  .ui-menu-lien:hover, .ui-menu-lien[aria-current=\"page\"] {\n    background: var(--surface-2);\n  