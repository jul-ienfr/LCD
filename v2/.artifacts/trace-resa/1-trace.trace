ound: var(--fond);\n  background-attachment: fixed;\n  color: var(--encre);\n  font-family: var(--police-texte);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n@supports (color: color-mix(in oklab, red, red)) {\n  body {\n    background-image: radial-gradient( 70rem 42rem at 88% -12%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70% ), radial-gradient( 54rem 34rem at -10% 8%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 72% );\n  }\n}\n@media (max-width: 767px) {\n  body {\n    background-attachment: scroll;\n  }\n}\n.apparence {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.min-h-dvh {\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n.apercu-bandeau {\n  position: sticky;\n  top: 0;\n  z-index: 50;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  padding: 0.5rem 1rem;\n  background: var(--accent);\n  color: var(--sur-accent);\n  font-size: 0.875rem;\n  font-weight: 600;\n}\nh1, h2, h3, h4, h5, h6 {\n  font-family: var(--police-titre);\n  font-weight: var(--graisse-titre);\n  letter-spacing: var(--interlettrage-titre);\n  text-wrap: balance;\n}\np {\n  text-wrap: pretty;\n}\n::selection {\n  background: var(--accent);\n  color: var(--sur-accent);\n}\ncode, pre, kbd, samp {\n  font-family: var(--police-mono);\n}\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n  border-radius: 0.5rem;\n}\n@layer components {\n  .ui-carte {\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    padding: var(--espace-carte);\n    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n  }\n  .ui-carte--liee:hover {\n    border-color: var(--accent);\n    @supports (color: color-mix(in lab, red, red)) {\n      border-color: color-mix(in oklab, var(--accent) 45%, var(--bordure))