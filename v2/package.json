    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "measure:js": "node scripts/measure-js.mjs",
    "assets:photos": "node scripts/generer-variantes-photos.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:a11y:staff": "node scripts/audit-a11y.mjs --staff",
    "audit:a11y:public": "node scripts/audit-a11y.mjs --public",
    "audit:cibles": "node scripts/mesurer-cibles.mjs",
    "audit:ergonomie": "node scripts/audit-ergonomie.mjs",
    "audit:ergonomie:ecrire": "node scripts/audit-ergonomie.mjs --ecrire",
