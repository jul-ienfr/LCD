# Copier vers .env.prod sur le serveur, puis remplir les valeurs.
# Ne jamais committer .env.prod.

# Domaine public (DNS A/AAAA doit pointer vers le VPS).
DOMAIN=lcd.example.fr

# PostgreSQL interne au compose.
POSTGRES_USER=lcd
POSTGRES_PASSWORD=change-me-with-openssl-rand-hex-24
POSTGRES_DB=lcd
# Owner : migrations, seed, sauvegardes.
MIGRATION_DATABASE_URL=postgres://lcd:change-me-with-openssl-rand-hex-24@postgres:5432/lcd
# Rôle applicatif non-propriétaire : RLS réellement appliquée.
# Créer le rôle avec `npm run db:role-app` après les migrations.
APP_ROLE_NAME=lcd_app
APP_ROLE_PASSWORD=change-me-app-role-hex-24
DATABASE_URL=postgres://lcd_app:change-me-app-role-hex-24@postgres:5432/lcd

# URL publiques
APP_URL=https://lcd.example.fr
BETTER_AUTH_URL=https://lcd.example.fr
BETTER_AUTH_SECRET=change-me-with-openssl-rand-hex-32
BETTER_AUTH_TRUSTED_ORIGINS=

# Email (désactivé tant qu'aucun SMTP de production n'est configuré)
EMAIL_ENABLED=false
EMAIL_FROM=LCD Parc <no-reply@lcd.example.fr>
SMTP_URL=

# SMS transactionnels Brevo (facultatif)
SMS_ENABLED=false
BREVO_API_KEY=
BREVO_SMS_SENDER=LCD

# Sauvegardes (scripts VPS/GitHub, facultatif) — clé base64 32 octets
BACKUP_ENCRYPTION_KEY=

# Paiement (facultatif)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assistant LLM (facultatif) : endpoint OpenAI-compatible complet.
# Laisser vide pour le générateur local déterministe.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MODEL_PREMIUM=

# Cron OTA + webhooks
CRON_SECRET=change-me-with-openssl-rand-hex-32

# Connecteurs runtime box (facultatif) : JSON indexé par boxId.
BOX_RUNTIME_CONFIG=

# Observabilité (facultatif)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Seed admin : uniquement pour la première initialisation, à retirer ensuite.
SEED_ADMIN_EMAIL=admin@lcd.example.fr
SEED_ADMIN_PASSWORD=change-me-with-at-least-12-chars
SEED_TENANT_SLUG=lcd
