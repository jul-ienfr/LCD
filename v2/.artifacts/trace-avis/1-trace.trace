olor: #ffffff;\n    border-color: var(--danger);\n  }\n  .ui-bouton--petit {\n    min-height: 2.25rem;\n    padding: 0.35rem 0.8rem;\n    font-size: 0.8125rem;\n  }\n  .ui-bouton--large {\n    width: 100%;\n  }\n  .ui-champ {\n    width: 100%;\n    min-height: var(--hauteur-controle);\n    padding: 0.5rem 0.75rem;\n    background: var(--fond);\n    color: var(--encre);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    font-family: var(--police-texte);\n    font-size: 0.875rem;\n  }\n  .ui-champ:focus-visible {\n    border-color: var(--accent);\n  }\n  .ui-champ[aria-invalid=\"true\"] {\n    border-color: var(--danger);\n  }\n  .ui-label {\n    display: block;\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: var(--encre);\n  }\n  .ui-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.35rem;\n    padding: 0.2rem 0.65rem;\n    border-radius: 999px;\n    background: var(--surface-2);\n    color: var(--encre-douce);\n    font-size: 0.75rem;\n    font-weight: 600;\n    line-height: 1.4;\n  }\n  .ui-badge--accent {\n    background: var(--accent-douce);\n    color: var(--accent);\n  }\n  .ui-badge--ok {\n    background: var(--ok-douce);\n    color: var(--ok);\n  }\n  .ui-badge--alerte {\n    background: var(--alerte-douce);\n    color: var(--alerte);\n  }\n  .ui-badge--danger {\n    background: var(--danger-douce);\n    color: var(--danger);\n  }\n  .ui-alerte {\n    padding: 0.9rem 1rem;\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-controle);\n    background: var(--surface);\n    color: var(--encre);\n    font-size: 0.875rem;\n  }\n  .ui-alerte--ok {\n    background: var(--ok-douce);\n    border-color: var(--ok);\n    color: var(--ok);\n  }\n  .ui-alerte--succes {\n    background: var(--ok-douce);\n    border-color: var(--ok);\n    color: var(--ok);\n  }\n  .ui-etiquette, .ui-etiquette-ui {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 2rem;\n    padding: 0.25rem 0.75rem;\n    border: var(--bordure-largeur) solid transparent;\n    border-radius: 999px;\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.04em;\n    text-decoration: none;\n  }\n  .ui-etiquette-ui {\n    background: var(--surface);\n    border-color: var(--bordure);\n    color: var(--encre-douce);\n  }\n  .ui-etiquette-ui:hover {\n    border-color: var(--accent);\n    color: var(--accent);\n  }\n  .ui-champ-groupe {\n    display: flex;\n    flex-direction: column;\n    gap: 0.4rem;\n  }\n  .ui-alerte--alerte {\n    background: var(--alerte-douce);\n    border-color: var(--alerte);\n    color: var(--alerte);\n  }\n  .ui-alerte--danger {\n    background: var(--danger-douce);\n    border-color: var(--danger);\n    color: var(--danger);\n  }\n  .ui-nav {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 0.35rem;\n    padding: 0.35rem;\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-bouton);\n    background: var(--surface);\n  }\n  .ui-nav-lien {\n    display: inline-flex;\n    align-items: center;\n    min-height: 2.25rem;\n    padding: 0.35rem 0.9rem;\n    border-radius: var(--rayon-bouton);\n    color: var(--encre-douce);\n    font-size: 0.875rem;\n    font-weight: 600;\n    text-decoration: none;\n    transition: background-color 160ms ease, color 160ms ease;\n  }\n  .ui-nav-lien:hover {\n    background: var(--surface-2);\n    color: var(--encre);\n  }\n  .ui-nav-lien[aria-current=\"page\"] {\n    background: var(--encre);\n    color: var(--fond);\n  }\n  [data-nav=\"souligne\"] .ui-nav {\n    border: 0;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    border-radius: 0;\n    padding: 0;\n    background: transparent;\n    gap: 1.25rem;\n  }\n  [data-nav=\"souligne\"] .ui-nav-lien {\n    border-radius: 0;\n    padding: 0.65rem 0;\n    border-bottom: 2px solid transparent;\n  }\n  [data-nav=\"souligne\"] .ui-nav-lien:hover {\n    background: transparent;\n  }\n  [data-nav=\"souligne\"] .ui-nav-lien[aria-current=\"page\"] {\n    background: transparent;\n    color: var(--accent);\n    border-bottom-color: var(--accent);\n  }\n  [data-nav=\"bloc\"] .ui-nav {\n    border: 0;\n    border-radius: 0;\n    padding: 0;\n    background: transparent;\n    gap: 0;\n  }\n  [data-nav=\"bloc\"] .ui-nav-lien {\n    border-radius: 0;\n    padding: 0.65rem 0.9rem;\n    border-right: var(--bordure-largeur) solid var(--bordure);\n  }\n  [data-nav=\"bloc\"] .ui-nav-lien:last-child {\n    border-right: 0;\n  }\n  [data-nav=\"bloc\"] .ui-nav-lien[aria-current=\"page\"] {\n    background: var(--accent);\n    color: var(--sur-accent);\n  }\n  [data-entete=\"centre\"] .ui-entete {\n    text-align: center;\n    align-items: center;\n    margin-inline: auto;\n  }\n  [data-entete=\"editorial\"] .ui-entete h1 {\n    font-size: clamp(2rem, 4vw, 2.75rem);\n    max-width: 22ch;\n  }\n  .ui-kpi {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    gap: 0.25rem;\n    padding: var(--espace-carte);\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-carte);\n    overflow: hidden;\n  }\n  .ui-kpi::before {\n    content: \"\";\n    position: absolute;\n    inset: 0 0 auto;\n    height: 2px;\n    background: linear-gradient(90deg, var(--accent), transparent);\n    opacity: 0.7;\n  }\n  .ui-kpi-valeur {\n    font-family: var(--police-titre);\n    font-size: 1.9rem;\n    font-weight: var(--graisse-titre);\n    letter-spacing: var(--interlettrage-titre);\n    font-variant-numeric: tabular-nums;\n  }\n  .ui-tableau {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 0.875rem;\n  }\n  .ui-tableau th {\n    text-align: left;\n    padding: 0.75rem 1rem;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    color: var(--encre-faine);\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n  }\n  .ui-tableau td {\n    padding: 0.75rem 1rem;\n    border-bottom: var(--bordure-largeur) solid var(--bordure);\n    vertical-align: top;\n  }\n  .ui-tableau tr:last-child td {\n    border-bottom: 0;\n  }\n  .ui-tableau tbody tr {\n    transition: background-color 140ms ease;\n  }\n  .ui-tableau tbody tr:hover {\n    background: var(--surface-2);\n  }\n  @supports (color: color-mix(in oklab, red, red)) {\n    .ui-tableau tbody tr:hover {\n      background: color-mix(in oklab, var(--accent) 5%, transparent);\n    }\n  }\n  .ui-menu {\n    position: relative;\n  }\n  .ui-menu > summary {\n    list-style: none;\n    cursor: pointer;\n  }\n  .ui-menu > summary::-webkit-details-marker {\n    display: none;\n  }\n  .ui-menu > summary::after {\n    content: \"＋\";\n    font-size: 0.9em;\n    line-height: 1;\n  }\n  .ui-menu[open] > summary::after {\n    content: \"−\";\n  }\n  .ui-menu-panneau {\n    position: absolute;\n    right: 0;\n    top: calc(100% + 0.6rem);\n    z-index: 40;\n    width: min(44rem, calc(100vw - 2rem));\n    max-height: min(32rem, 72dvh);\n    overflow-y: auto;\n    padding: 1.1rem;\n    display: grid;\n    gap: 1rem;\n    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));\n    background: var(--surface);\n    border: var(--bordure-largeur) solid var(--bordure);\n    border-radius: var(--rayon-carte);\n    box-shadow: var(--ombre-elevee);\n  }\n  .ui-menu-groupe {\n    display: flex;\n    flex-direction: column;\n    gap: 0.15rem;\n    min-width: 0;\n  }\n  .ui-menu-titre {\n    padding: 0.25rem 0.6rem;\n    color: var(--encre-faine);\n    font-size: 0.6875rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  .ui-menu-lien {\n    padding: 0.45rem 0.6rem;\n    border-radius: 0.5rem;\n    color: var(--encre-douce);\n    font-size: 0.875rem;\n    font-weight: 500;\n    text-decoration: none;\n  }\n  